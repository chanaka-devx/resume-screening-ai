meta {
  name: List Public Jobs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/public/jobs
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
  ~search: python
  ~location: remote
}

docs {
  ## Public Job Listings

  Returns paginated **published** jobs. No authentication required.

  ### Query Parameters
  | Param    | Type    | Default | Description                                         |
  |----------|---------|---------|-----------------------------------------------------|
  | page     | integer | 1       | Page number (1-based)                               |
  | limit    | integer | 10      | Items per page (max 100)                            |
  | search   | string  | —       | Case-insensitive search in title and description    |
  | location | string  | —       | Filter: `on-site` / `hybrid` / `remote`             |

  ### Response fields (applicant-safe)
  `id` · `title` · `description` · `location` · `deadline` · `posted_at`

  ### Example requests
  - All published jobs:        `GET /api/v1/public/jobs`
  - Page 2:                    `GET /api/v1/public/jobs?page=2&limit=10`
  - Search:                    `GET /api/v1/public/jobs?search=python`
  - Filter remote only:        `GET /api/v1/public/jobs?location=remote`
  - Combined:                  `GET /api/v1/public/jobs?search=engineer&location=hybrid`
}
