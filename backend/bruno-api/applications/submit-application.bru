meta {
  name: Submit Application
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/applications
  body: json
  auth: none
}

body:json {
  {
    "job_id": "{{job_id}}",
    "resume_id": "{{resume_id}}"
  }
}

script:post-response {
  // Auto-save the application ID for use in subsequent requests
  if (res.status === 201) {
    bru.setEnvVar("application_id", res.body.id);
  }
}
