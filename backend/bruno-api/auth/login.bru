meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john@company.com",
    "password": "Password123"
  }
}

script:post-response {
  // Auto-save the JWT token to the environment after a successful login
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.access_token);
  }
}
