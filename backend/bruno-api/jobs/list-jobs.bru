meta {
  name: List My Jobs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/jobs?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~status: draft
  ~location: remote
  ~search: backend
}

auth:bearer {
  token: {{token}}
}

docs {
  ## RS-018 — Recruiter Job Listing
  
  Returns a paginated list of **your own** job postings.
  
  ### Query Parameters
  | Param    | Type    | Default | Description                                      |
  |----------|---------|---------|--------------------------------------------------|
  | page     | integer | 1       | Page number (1-based)                            |
  | limit    | integer | 10      | Items per page (max 100)                         |
  | status   | string  | —       | Filter: `draft` / `published` / `closed`         |
  | location | string  | —       | Filter: `on-site` / `hybrid` / `remote`          |
  | search   | string  | —       | Case-insensitive search in title and description |
  
  ### Example requests
  - All jobs (page 2):     `GET /jobs?page=2&limit=10`
  - Draft only:            `GET /jobs?status=draft`
  - Remote jobs only:      `GET /jobs?location=remote`
  - Search:                `GET /jobs?search=backend`
  - Combined:              `GET /jobs?status=published&location=hybrid&search=engineer`
}
